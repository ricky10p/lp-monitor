# Port & host dashboard
PORT=3000
# 127.0.0.1 = hanya bisa dibuka dari komputer ini (di VPS: tetap 127.0.0.1 jika memakai Nginx).
# HOST=0.0.0.0 membuka port langsung ke internet — WAJIB isi DASHBOARD_PASSWORD.
HOST=127.0.0.1
# Password login dashboard (kosong = tanpa login, hanya boleh untuk HOST localhost di luar production).
# NODE_ENV=production (pm2 / ecosystem.config.cjs) selalu mewajibkan password.
# Di VPS selalu isi, karena Nginx membuat dashboard bisa diakses dari luar.
DASHBOARD_PASSWORD=
# Opsional: kunci cookie login (default diturunkan dari password)
SESSION_SECRET=
# true jika dashboard diakses lewat HTTPS (mis. di belakang Nginx + SSL)
SECURE_COOKIE=false
# Interval pengecekan wallet (detik, minimal 5)
POLL_INTERVAL_SEC=5
# Berapa wallet dicek bersamaan dalam satu siklus (1-16).
# Jika log sering menampilkan error 429, turunkan angka ini atau naikkan POLL_INTERVAL_SEC.
TRACKER_CONCURRENCY=4
# Berapa kali posisi harus hilang sebelum dianggap close (jika data close belum tersedia di API)
CLOSE_CONFIRM_POLLS=3
# RPC Solana awal (hanya dipakai sekali saat database baru dibuat). Setelah itu RPC dikelola
# dari halaman Pengaturan di dashboard: bisa lebih dari satu, otomatis pindah jika satu mati.
# Dipakai untuk saldo SOL/USDC wallet (Total aset) dan pembacaan strategi posisi DLMM
# (Spot/Curve/BidAsk). RPC publik cepat kena limit 429 — disarankan Helius:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=API_KEY_ANDA
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Lokasi database SQLite
DB_PATH=data/monitor.db
# Binary curl untuk scan GMGN (Track Wallet). Kosong = curl bawaan (cukup di Windows).
# Di VPS Linux, curl bawaan diblokir Cloudflare GMGN (fingerprint TLS) — pasang curl-impersonate
# (lihat DEPLOY.md) lalu isi path wrapper-nya, mis.:
#   GMGN_CURL=/usr/local/bin/curl_chrome131
GMGN_CURL=
